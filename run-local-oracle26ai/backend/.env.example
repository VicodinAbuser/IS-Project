# Copy this file to ".env" (same folder) and change values if yours are different.
# Defaults match Oracle AI Database 26ai Free installed on this laptop.
# Oracle 21c: use your pluggable database name, usually ORACLE_DSN=localhost:1521/ORCLPDB
# (setup_db.py --create-user / 2-setup-database.bat writes this line for you.)
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_USER=inventory
ORACLE_PASSWORD=inventory123

# Change this to any long random text before a real deployment.
JWT_SECRET=change-this-secret-in-production
